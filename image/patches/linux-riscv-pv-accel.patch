diff --git a/arch/riscv/Kconfig b/arch/riscv/Kconfig
index 593cf0926..ce1585dce 100644
--- a/arch/riscv/Kconfig
+++ b/arch/riscv/Kconfig
@@ -681,6 +681,19 @@ config PORTABLE
 	select OF
 	select MMU
 
+config RISCV_PV_ACCEL
+	bool "Paravirtual acceleration for bulk memory operations"
+	depends on MMU
+	help
+	  Route page clearing/copying and bulk memset/memcpy through a
+	  TinyEMU paravirtual hypercall (custom-0, funct7 0x70).  This is only
+	  meaningful under an emulator that implements the hypercall, such as
+	  the container2wasm/AgentVM TinyEMU build.  If the emulator does not
+	  implement it, the custom instruction raises an illegal-instruction
+	  trap, so do NOT enable this on real hardware or on a stock emulator.
+	  The emulator itself falls back to the software routine when a range
+	  is not plain RAM (MMIO, unmapped), so correctness is preserved.
+
 menu "Power management options"
 
 source "kernel/power/Kconfig"
diff --git a/arch/riscv/include/asm/page.h b/arch/riscv/include/asm/page.h
index ac70b0fd9..399197dec 100644
--- a/arch/riscv/include/asm/page.h
+++ b/arch/riscv/include/asm/page.h
@@ -49,12 +49,24 @@
 
 #ifndef __ASSEMBLY__
 
+#ifdef CONFIG_RISCV_PV_ACCEL
+void pv_clear_page(void *page);
+void pv_copy_page(void *to, void *from);
+void pv_clear_user_page(void *page, unsigned long vaddr);
+void pv_copy_user_page(void *to, void *from, unsigned long vaddr);
+#define clear_page(pgaddr)			pv_clear_page(pgaddr)
+#define copy_page(to, from)			pv_copy_page((to), (from))
+#define clear_user_page(pgaddr, vaddr, page)	pv_clear_user_page((pgaddr), (vaddr))
+#define copy_user_page(vto, vfrom, vaddr, topg) \
+			pv_copy_user_page((vto), (vfrom), (vaddr))
+#else
 #define clear_page(pgaddr)			memset((pgaddr), 0, PAGE_SIZE)
 #define copy_page(to, from)			memcpy((to), (from), PAGE_SIZE)
 
 #define clear_user_page(pgaddr, vaddr, page)	memset((pgaddr), 0, PAGE_SIZE)
 #define copy_user_page(vto, vfrom, vaddr, topg) \
 			memcpy((vto), (vfrom), PAGE_SIZE)
+#endif
 
 /*
  * Use struct definitions to apply C type checking
