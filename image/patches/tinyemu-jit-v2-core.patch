+/* ---- PC sampler and deterministic trace ring --------------------- */
+
+#define JIT_SAMPLE_RING_SIZE 8192
+#define JIT_TRACE_RING_SIZE  4096
+
+static uint64_t jit_sample_pcs[JIT_SAMPLE_RING_SIZE];
+static uint32_t jit_sample_head;
+static uint64_t jit_sample_interval = 1u << 16;
+static uint64_t jit_sample_next;
+static int32_t jit_sampler_enabled;
+
+static uint64_t jit_trace_hashes[JIT_TRACE_RING_SIZE];
+static uint32_t jit_trace_head_idx;
+static uint64_t jit_trace_interval = 1u << 20;
+static uint64_t jit_trace_next;
+static int32_t jit_trace_enabled;
+static int32_t jit_diag_enabled;
+
+static uint64_t jit_state_hash_impl(RISCVCPUState *s)
+{
+    uint64_t h = 1469598103934665603ULL;
+    int i;
+#define JIT_HASH_MIX(v) do { \
+        h ^= (uint64_t)(v); \
+        h *= 1099511628211ULL; \
+    } while (0)
+    JIT_HASH_MIX(s->pc);
+    for (i = 1; i < 32; i++)
+        JIT_HASH_MIX(s->reg[i]);
+    JIT_HASH_MIX(s->priv);
+    JIT_HASH_MIX(s->fs);
+    JIT_HASH_MIX(s->satp);
+#if FLEN > 0
+    JIT_HASH_MIX(s->fflags);
+    JIT_HASH_MIX(s->frm);
+    for (i = 0; i < 32; i++)
+        JIT_HASH_MIX(s->fp_reg[i]);
+#endif
+    JIT_HASH_MIX(s->load_res);
+#undef JIT_HASH_MIX
+    return h;
+}
+
+/* Called at interpreter block boundaries. `now` is the live instruction
+   counter (s->insn_counter is only flushed when the interpreter exits). */
+static inline void jit_sample_tick(RISCVCPUState *s, uint64_t now)
+{
+    if (likely(!jit_sampler_enabled && !jit_trace_enabled))
+        return;
+    if (jit_sampler_enabled && now >= jit_sample_next) {
+        jit_sample_pcs[jit_sample_head & (JIT_SAMPLE_RING_SIZE - 1)] = (uint64_t)s->pc;
+        jit_sample_head++;
+        jit_sample_next = now + jit_sample_interval;
+    }
+    if (jit_trace_enabled && now >= jit_trace_next) {
+        jit_trace_hashes[jit_trace_head_idx & (JIT_TRACE_RING_SIZE - 1)] = jit_state_hash_impl(s);
+        jit_trace_head_idx++;
+        jit_trace_next = now + jit_trace_interval;
+    }
+}
+
+__attribute__((export_name("jit_sampler_enable")))
+void jit_sampler_enable(uint32_t interval)
+{
+    jit_sample_interval = interval ? interval : (1u << 16);
+    jit_sample_head = 0;
+    jit_sample_next = jit_cpu_state ? jit_cpu_state->insn_counter + jit_sample_interval : 0;
+    jit_sampler_enabled = 1;
+    jit_diag_enabled = 1;
+}
