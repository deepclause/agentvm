+#ifdef CONFIG_JIT
+/* ================================================================== */
+/* Region-JIT infrastructure (v2)                                     */
+/*                                                                    */
+/* The emulator keeps a jump cache (vPC -> region table index), a      */
+/* physical map (pPC + mode -> table index + generation) and a        */
+/* generation word per guest physical page for self-modifying code.    */
+/* The translator worker only installs finished regions.              */
+/* ================================================================== */
+
+#define JIT_STATUS_CONTINUE  0
+#define JIT_STATUS_EXCEPTION 1
+#define JIT_STATUS_BUDGET    2
+#define JIT_STATUS_INTERP    3
+
+#define JIT_STORE_OK         0
+#define JIT_STORE_FAULT      1
+#define JIT_STORE_INVALID    2
+#define JIT_STORE_SLOW       3
+
+#define JIT_PAGE_SHIFT       12
+#define JIT_PAGE_GEN_BITS    20
+#define JIT_PAGE_GEN_SIZE    (1u << JIT_PAGE_GEN_BITS)
+#define JIT_PAGE_GEN_MASK    (JIT_PAGE_GEN_SIZE - 1)
+#define JIT_WATCH_BYTES      (JIT_PAGE_GEN_SIZE / 8)
+
+#define JIT_JC_ENTRIES       (1u << 16)
+#define JIT_JC_BUCKETS       (1u << 10)
+#define JIT_JC_BUCKET_ENTRIES 64
+#define JIT_HOT_SIZE         (1u << 16)
+#define JIT_REGION_HOT_THRESHOLD 128
+/* Runtime value (jit_set_hot_threshold); tests use 1 to translate every
+   dispatched PC. */
+static uint32_t jit_hot_threshold = JIT_REGION_HOT_THRESHOLD;
+#define JIT_PHYS_SIZE        (1u << 16)
+/* Bounded linear probing: a lookup miss must stay cheap even when the map is
+   nearly full, because it runs on every jump-cache miss. An insert that finds
+   no free slot within the bound fails, and the host then starts a new epoch. */
+#define JIT_PHYS_MAX_PROBE   16
+
+typedef int32_t (*jit_region_fn_t)(uint32_t state_ptr, uint64_t pc,
+                                   uint32_t ppage, uint32_t expected_gen);
+
+typedef struct {
+    uint64_t vpc;
+    uint32_t table_idx;
+    uint32_t ppage;
+    uint32_t expected_gen;
+    uint16_t jc_gen;
+    uint8_t priv;
+    uint8_t fsbit;
+} JITJumpEntry;
+
+typedef struct {
+    uint64_t paddr;
+    uint32_t table_idx;
+    uint32_t gen;
+    uint8_t priv;
+    uint8_t fsbit;
+    uint8_t valid;
+    uint8_t pad;
+} JITPhysEntry;
+
+typedef struct {
+    uint64_t pc;
+    uint16_t hits;
+    uint16_t crossings; /* threshold crossings without a region (backoff) */
+} JITHotEntry;
+
+typedef struct {
+    uint64_t dispatches;
+    uint64_t jump_hits;
+    uint64_t jump_misses;
+    uint64_t region_calls;
+    uint64_t exits_continue;
+    uint64_t exits_exception;
+    uint64_t exits_budget;
+    uint64_t exits_interp;
+    uint64_t requests;
+    uint64_t installs;
+    uint64_t install_rejects;
+    uint64_t invalidations;
+    uint64_t watch_marks;
+    uint64_t flush_all;
+    uint64_t chained;   /* region-to-region transfers done in wasm */
+} JITStats;
+
+static uint32_t jit_page_gen[JIT_PAGE_GEN_SIZE];
+static uint8_t jit_watched[JIT_WATCH_BYTES];
+static JITJumpEntry jit_jump_cache[JIT_JC_ENTRIES];
+static JITPhysEntry jit_phys_map[JIT_PHYS_SIZE];
+static JITHotEntry jit_hot[JIT_HOT_SIZE];
+static JITStats jit_stats;
+static uint32_t jit_jump_gen = 1;
+static RISCVCPUState *jit_cpu_state;
+static int32_t jit_region_enabled;
+static int32_t jit_step_active;
+static uint32_t jit_region_count;
+/* Bumped on every install: negative jump-cache entries (table_idx == 0,
+   "no region for this PC") are only valid while it is unchanged. */
+static uint32_t jit_install_seq = 1;
+static int32_t jit_diag_enabled; /* defined with the diagnostics below */
+
+__attribute__((import_module("env"), import_name("jit_request_region")))
+int32_t jit_request_region(uint32_t state_ptr, uint64_t paddr,
+                           uint32_t entry_off, uint32_t priv, uint32_t fs,
+                           uint32_t expected_gen);
+__attribute__((import_module("env"), import_name("jit_poll")))
+void jit_poll_import(void);
+
+static inline uint32_t jit_page_index(uint64_t paddr)
+{
+    return (uint32_t)((paddr >> JIT_PAGE_SHIFT) & JIT_PAGE_GEN_MASK);
+}
+
+static BOOL jit_page_watched(uint64_t paddr)
+{
+    uint32_t pg = jit_page_index(paddr);
+    return (jit_watched[pg >> 3] >> (pg & 7)) & 1;
+}
+
+void jit_flush_jump_cache(void)
+{
+    jit_jump_gen++;
+    if (jit_jump_gen == 0)
+        jit_jump_gen = 1;
+    if ((jit_jump_gen & 0xffff) == 0) {
+        /* The tag stores the low 16 bits of the generation. Clear the cache
+           before the tag wraps so an old entry cannot compare equal. */
+        memset(jit_jump_cache, 0, sizeof(jit_jump_cache));
+    }
+    jit_stats.flush_all++;
+}
+
+/* Watch a page before requesting a translation. Existing write-TLB entries
+   for the page could otherwise bypass the invalidation hook, so drop the
+   write TLB once when a page becomes watched. */
+static uint32_t jit_watch_page(RISCVCPUState *s, uint64_t paddr)
+{
+    uint32_t pg = jit_page_index(paddr);
+    int i;
+
+    if (!(jit_watched[pg >> 3] & (uint8_t)(1u << (pg & 7)))) {
+        PhysMemoryRange *pr = get_phys_mem_range(s->mem_map, paddr);
+        jit_watched[pg >> 3] |= (uint8_t)(1u << (pg & 7));
+        jit_stats.watch_marks++;
+        if (pr && pr->is_ram) {
+            /* Drop only the write-TLB entries that map this physical page
+               (any virtual alias); flushing the whole write TLB made every
+               other page take the slow store path again. */
+            uintptr_t host = (uintptr_t)(pr->phys_mem +
+                                         ((paddr & ~(uint64_t)PG_MASK) - pr->addr));
+            for (i = 0; i < TLB_SIZE; i++) {
+                if (s->tlb_write[i].vaddr != (target_ulong)-1 &&
+                    s->tlb_write[i].mem_addend +
+                    (uintptr_t)(s->tlb_write[i].vaddr & ~(target_ulong)PG_MASK) == host)
+                    s->tlb_write[i].vaddr = -1;
+            }
+        } else {
+            for (i = 0; i < TLB_SIZE; i++)
+                s->tlb_write[i].vaddr = -1;
+        }
+    }
+    return jit_page_gen[pg];
+}
+
+static void jit_invalidate_paddr(uint64_t paddr)
+{
+    uint32_t pg = jit_page_index(paddr);
+    uint8_t mask = (uint8_t)(1u << (pg & 7));
+    if (jit_watched[pg >> 3] & mask) {
+        jit_watched[pg >> 3] &= (uint8_t)~mask;
+        jit_page_gen[pg]++;
+        if (jit_page_gen[pg] == 0)
+            jit_page_gen[pg] = 1;
+        jit_stats.invalidations++;
+    }
+}
+
+static void jit_note_write_paddr(uint64_t paddr, size_t size)
+{
+    uint64_t last;
+    if (!jit_region_enabled || size == 0)
+        return;
+    last = paddr + (uint64_t)size - 1;
+    for (;;) {
+        jit_invalidate_paddr(paddr);
+        if ((paddr & ~(uint64_t)PG_MASK) == (last & ~(uint64_t)PG_MASK))
+            break;
+        paddr = (paddr & ~(uint64_t)PG_MASK) + (1u << JIT_PAGE_SHIFT);
+    }
+}
+
+static void jit_note_write_range(uint64_t paddr, size_t size)
+{
+    jit_note_write_paddr(paddr, size);
+}
+
+/* Called by the WASM code paths that write guest RAM (virtio DMA and the PV
+   bulk memops) through the memory map callback. */
+void riscv_cpu_jit_note_write(uint64_t paddr, size_t size)
+{
+    jit_note_write_range(paddr, size);
+}
+
+/* Map a host (linear-memory) pointer back to a guest physical address. */
+static uint64_t jit_host_to_paddr(RISCVCPUState *s, const uint8_t *host)
+{
+    PhysMemoryMap *map = s->mem_map;
+    int i;
+    for (i = 0; i < map->n_phys_mem_range; i++) {
+        PhysMemoryRange *pr = &map->phys_mem_range[i];
+        if (pr->is_ram && pr->size != 0 &&
+            host >= pr->phys_mem && host < pr->phys_mem + pr->size) {
+            return pr->addr + (uint64_t)(host - pr->phys_mem);
+        }
+    }
+    return UINT64_MAX;
+}
+
+static uint64_t jit_vpc_to_paddr(RISCVCPUState *s, target_ulong pc)
+{
+    uint32_t tlb_idx = (uint32_t)((pc >> PG_SHIFT) & (TLB_SIZE - 1));
+    uint8_t *host;
+    if (s->tlb_code[tlb_idx].vaddr == ((pc & ~(target_ulong)PG_MASK) ^ s->tlb_code_tag)) {
+        host = (uint8_t *)(s->tlb_code[tlb_idx].mem_addend + (uintptr_t)pc);
+    } else {
+        int saved = s->pending_exception;
+        uint8_t *ptr;
+        if (target_read_insn_slow(s, &ptr, pc)) {
+            s->pending_exception = saved;
+            return UINT64_MAX;
+        }
+        s->pending_exception = saved;
+        host = ptr;
+    }
+    return jit_host_to_paddr(s, host);
+}
+
+static inline uint32_t jit_jc_index(target_ulong pc)
+{
+    uint32_t vpn = (uint32_t)(pc >> PG_SHIFT);
+    uint32_t bucket = (vpn * 2654435761u) & (JIT_JC_BUCKETS - 1);
+    uint32_t slot = (uint32_t)((pc >> 1) & (JIT_JC_BUCKET_ENTRIES - 1));
+    return bucket * JIT_JC_BUCKET_ENTRIES + slot;
+}
+
+static JITPhysEntry *jit_phys_find(uint64_t paddr, int priv, int fsbit,
+                                   BOOL create)
+{
+    uint32_t h = (uint32_t)((paddr >> 3) ^ (paddr >> 19) ^
+                            ((uint32_t)priv * 0x9e3779b1u) ^
+                            ((uint32_t)fsbit << 15));
+    uint32_t i;
+    h ^= h >> 16;
+    h *= 0x45d9f3bu;
+    h ^= h >> 16;
+    for (i = 0; i < JIT_PHYS_MAX_PROBE; i++) {
+        JITPhysEntry *e = &jit_phys_map[(h + i) & (JIT_PHYS_SIZE - 1)];
+        if (!e->valid)
+            return create ? e : NULL;
+        if (e->paddr == paddr && e->priv == priv && e->fsbit == fsbit)
+            return e;
+    }
+    return NULL;
+}
+
+
+static void jit_fill_jump(RISCVCPUState *s, JITJumpEntry *e, target_ulong pc,
+                          uint64_t paddr, uint32_t table_idx, uint32_t gen)
+{
+    e->vpc = (uint64_t)pc;
+    e->table_idx = table_idx;
+    e->ppage = (uint32_t)(paddr >> PG_SHIFT);
+    e->expected_gen = gen;
+    e->jc_gen = (uint16_t)jit_jump_gen;
+    e->priv = s->priv;
+    e->fsbit = (s->fs != 0);
+}
+
+/* Hotness gate shared by the taken-branch probe and the block-boundary
+   dispatcher. Resolution is only attempted at the threshold, so unsupported
+   PCs do not pay a TLB/physical-map lookup on every branch. */
+static BOOL jit_hot_probe(RISCVCPUState *s, target_ulong pc)
+{
+    JITHotEntry *hot;
+    JITPhysEntry *pe;
+    uint64_t paddr, page_base;
+    uint32_t gen;
+
+    if (jit_step_active)
+        return FALSE;
+    hot = &jit_hot[(uint32_t)((pc >> 2) ^ (pc >> 13)) & (JIT_HOT_SIZE - 1)];
+    if (hot->pc != (uint64_t)pc) {
+        hot->pc = (uint64_t)pc;
+        hot->hits = 0;
+        hot->crossings = 0;
+    }
+    if (++hot->hits < jit_hot_threshold)
+        return FALSE;
+    hot->hits = 0;
+
+    paddr = jit_vpc_to_paddr(s, pc);
+    if (paddr == UINT64_MAX)
+        return FALSE;
+    pe = jit_region_count ? jit_phys_find(paddr, s->priv, s->fs != 0, FALSE) : NULL;
+    if (pe != NULL) {
+        gen = jit_page_gen[jit_page_index(paddr)];
+        if (gen == pe->gen) {
+            jit_fill_jump(s, &jit_jump_cache[jit_jc_index(pc)], pc, paddr,
+                          pe->table_idx, gen);
+            hot->crossings = 0;
+            return TRUE;
+        }
+    }
+    /* Request with exponential backoff: crossings 1, 2, 4, 8, ... A request
+       is a call into JS, and a PC that cannot be translated (or whose
+       translation is still in flight) would otherwise call again every
+       threshold crossing. The physical-map lookup above still runs every
+       time, so an installed region is found promptly. */
+    if (hot->crossings != 0xffff)
+        hot->crossings++;
+    if ((hot->crossings & (hot->crossings - 1)) != 0)
+        return FALSE;
+    page_base = paddr & ~(uint64_t)PG_MASK;
+    gen = jit_watch_page(s, page_base);
+    jit_stats.requests++;
+    jit_request_region((uint32_t)(uintptr_t)s, paddr,
+                       (uint32_t)(pc & PG_MASK), s->priv,
+                       s->fs != 0, gen);
+    /* Synchronous install: enter the new region on the next dispatch. For an
+       asynchronous worker this simply misses and retries later. */
+    pe = jit_phys_find(paddr, s->priv, s->fs != 0, FALSE);
+    if (pe != NULL && jit_page_gen[jit_page_index(paddr)] == pe->gen) {
+        jit_fill_jump(s, &jit_jump_cache[jit_jc_index(pc)], pc, paddr,
+                      pe->table_idx, pe->gen);
+        return TRUE;
+    }
+    return FALSE;
+}
