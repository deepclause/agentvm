+    switch (which) {
+    case 0: return (uint32_t)(uintptr_t)jit_jump_cache;
+    case 1: return (uint32_t)(uintptr_t)&jit_jump_gen;
+    case 2: return (uint32_t)(uintptr_t)&s->priv;
+    case 3: return (uint32_t)(uintptr_t)&s->fs;
+    case 4: return (uint32_t)(uintptr_t)&s->mip;
+    case 5: return (uint32_t)(uintptr_t)&s->mie;
