+/* Fast probe used by the interpreter for same-page taken branches. */
+static inline BOOL jit_probe_hit(RISCVCPUState *s, target_ulong pc)
+{
+    JITJumpEntry *e;
+    if (!jit_region_enabled || jit_step_active)
+        return FALSE;
+    /* Runs on every taken in-page branch: no statistics here unless the
+       diagnostics are on (they cost several percent of interpreter time). */
+    e = &jit_jump_cache[jit_jc_index(pc)];
+    if (e->vpc == (uint64_t)pc &&
+        e->jc_gen == (uint16_t)jit_jump_gen &&
+        e->priv == s->priv && e->fsbit == (s->fs != 0) &&
+        e->table_idx != 0) {
+        if (unlikely(jit_diag_enabled))
+            jit_stats.jump_hits++;
+        return TRUE;
+    }
+    if (unlikely(jit_diag_enabled))
+        jit_stats.jump_misses++;
+    return jit_hot_probe(s, pc);
+}
+
+/* Returns a JIT_STATUS_* value, or -1 when no region handled the PC. */
+static int32_t jit_try_region(RISCVCPUState *s)
+{
+    target_ulong pc = s->pc;
+    JITJumpEntry *je;
+    JITPhysEntry *pe;
+    uint64_t paddr;
+    uint32_t ppage, expected_gen, table_idx;
+    jit_region_fn_t fn;
+    int32_t status;
+
+    if (!jit_region_enabled || jit_step_active || jit_region_count == 0)
+        return -1;
+
+    je = &jit_jump_cache[jit_jc_index(pc)];
+    if (je->vpc == (uint64_t)pc &&
+        je->jc_gen == (uint16_t)jit_jump_gen &&
+        je->priv == s->priv && je->fsbit == (s->fs != 0)) {
+        if (je->table_idx == 0) {
+            /* Negative entry: no region for this PC as of the last install. */
+            if (je->expected_gen == jit_install_seq)
+                return -1;
+            goto resolve;
+        }
+        ppage = je->ppage;
+        expected_gen = je->expected_gen;
+        table_idx = je->table_idx;
+        jit_stats.region_calls++;
+        goto call_region;
+    }
+
+resolve:
+    paddr = jit_vpc_to_paddr(s, pc);
+    if (paddr == UINT64_MAX)
+        return -1;
+    pe = jit_phys_find(paddr, s->priv, s->fs != 0, FALSE);
+    expected_gen = jit_page_gen[jit_page_index(paddr)];
+    if (pe == NULL || expected_gen != pe->gen) {
+        /* Remember the miss so the next block boundary at this PC does not
+           resolve vPC -> pPC and probe the physical map again. */
+        je->vpc = (uint64_t)pc;
+        je->table_idx = 0;
+        je->expected_gen = jit_install_seq;
+        je->jc_gen = (uint16_t)jit_jump_gen;
+        je->priv = s->priv;
+        je->fsbit = (s->fs != 0);
+        return -1;
+    }
+    ppage = (uint32_t)(paddr >> PG_SHIFT);
+    table_idx = pe->table_idx;
+    je->vpc = (uint64_t)pc;
+    je->table_idx = table_idx;
+    je->ppage = ppage;
+    je->expected_gen = expected_gen;
+    je->jc_gen = (uint16_t)jit_jump_gen;
+    je->priv = s->priv;
+    je->fsbit = (s->fs != 0);
+    jit_stats.region_calls++;
+
+call_region:
+    fn = (jit_region_fn_t)(uintptr_t)table_idx;
+    status = fn((uint32_t)(uintptr_t)s, (uint64_t)pc, ppage, expected_gen);
+    switch (status) {
+    case JIT_STATUS_CONTINUE:
+        jit_stats.exits_continue++;
+        return JIT_STATUS_CONTINUE;
+    case JIT_STATUS_EXCEPTION:
+        jit_stats.exits_exception++;
+        return JIT_STATUS_EXCEPTION;
+    case JIT_STATUS_BUDGET:
+        jit_stats.exits_budget++;
+        return JIT_STATUS_BUDGET;
+    default:
+        jit_stats.exits_interp++;
+        /* A generation mismatch invalidates both cache levels. */
+        if (expected_gen != jit_page_gen[jit_page_index((uint64_t)ppage << PG_SHIFT)]) {
+            je->vpc = 0;
+        }
+        return JIT_STATUS_INTERP;
+    }
+}
+
+/* 1 = resume interpreter loop, -1 = exception, -2 = exit interpreter,
+   0 = no region / interpreter continues at s->pc. */
+static int32_t jit_dispatch(RISCVCPUState *s)
+{
+    int32_t st;
+    if (!jit_region_enabled || jit_step_active)
+        return 0;
+    if (jit_region_count != 0) {
+        st = jit_try_region(s);
+        if (st >= 0) {
+            switch (st) {
+            case JIT_STATUS_CONTINUE:
+                return 1;
+            case JIT_STATUS_EXCEPTION:
+                return -1;
+            case JIT_STATUS_BUDGET:
+                return -2;
+            default:
+                return 0;
+            }
+        }
+    }
+    /* Cold start or a PC without a translation: hotness is also counted at
+       block boundaries so cross-page calls/jumps can seed the first region. */
+    jit_hot_probe(s, s->pc);
+    return 0;
+}
