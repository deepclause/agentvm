+__attribute__((export_name("jit_install_region")))
+int32_t jit_install_region(uint64_t paddr, uint32_t table_idx,
+                           uint32_t priv, uint32_t fsbit,
+                           uint32_t expected_gen)
+{
+    JITPhysEntry *pe;
+    uint32_t pg = jit_page_index(paddr);
+
+    if (jit_page_gen[pg] != expected_gen) {
+        jit_stats.install_rejects++;
+        return -1;
+    }
+    pe = jit_phys_find(paddr, priv, fsbit, TRUE);
+    if (pe == NULL) {
+        jit_stats.install_rejects++;
+        return -2;
+    }
+    pe->paddr = paddr;
+    pe->table_idx = table_idx;
+    pe->gen = expected_gen;
+    pe->priv = (uint8_t)priv;
+    pe->fsbit = (uint8_t)fsbit;
+    pe->valid = 1;
+    jit_region_count++;
+    jit_install_seq++;
+    /* No jump-cache flush: an existing entry for the same PC points at an
+       equally valid region (the generation is checked at region entry). */
+    jit_stats.installs++;
+    return 0;
+}
