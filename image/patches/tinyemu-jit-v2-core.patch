+/* Addresses used by translated code to chain regions without returning to
+   the interpreter loop: the region's exit tail probes the jump cache inline
+   and tail-calls the next region (return_call_indirect). It must stop where
+   the interpreter loop would act: budget exhausted or an interrupt pending.
+   The layout of JITJumpEntry and jit_jc_index() are mirrored in
+   src/jit/emitter.js (JC_* constants). */
+_Static_assert(sizeof(JITJumpEntry) == 24, "JITJumpEntry layout");
+_Static_assert(offsetof(JITJumpEntry, table_idx) == 8, "JITJumpEntry layout");
+_Static_assert(offsetof(JITJumpEntry, ppage) == 12, "JITJumpEntry layout");
+_Static_assert(offsetof(JITJumpEntry, expected_gen) == 16, "JITJumpEntry layout");
+_Static_assert(offsetof(JITJumpEntry, jc_gen) == 20, "JITJumpEntry layout");
+_Static_assert(offsetof(JITJumpEntry, priv) == 22, "JITJumpEntry layout");
+_Static_assert(offsetof(JITJumpEntry, fsbit) == 23, "JITJumpEntry layout");
