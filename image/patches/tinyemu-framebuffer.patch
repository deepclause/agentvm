+/* Return (and clear) whether any framebuffer page was written since the last
+   call. The AgentVM host uses this to fetch only changed frames. */
+int simplefb_take_dirty(FBDevice *fb_dev)
+{
+    SimpleFBState *s = fb_dev->device_opaque;
+    const uint32_t *dirty_bits;
+    int i, nwords;
+
+    if (!s)
+        return 0;
+    dirty_bits = phys_mem_get_dirty_bits(s->mem_range);
+    nwords = (s->fb_page_count + 31) >> 5;
+    for (i = 0; i < nwords; i++) {
+        if (dirty_bits[i] != 0)
+            return 1;
+    }
+    return 0;
+}
