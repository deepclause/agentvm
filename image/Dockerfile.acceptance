# Acceptance image for AgentVM 0.2: riscv64 Alpine with Python + Node/npm.
#
# This is a *build-time* input. The shipped artifact is a portable .wasm file;
# the runtime never needs Docker or this Dockerfile.

# Alpine 3.21 ships Node 22 (pi requires >=22.19.0); 3.20 ships Node 20.
FROM alpine:3.21

# riscv64 Alpine has nodejs, npm, python3 and py3-pip. git/bash/curl are
# included so the VM can install and drive the pi coding agent.
RUN apk add --no-cache \
        python3 py3-pip \
        nodejs npm \
        bash curl git \
        coreutils \
        tmux \
        e2fsprogs \
        alsa-utils alsa-lib \
        jansson fzf

# Build hax (https://usehax.dev) from source; there are no riscv64 binaries.
RUN apk add --no-cache \
        build-base meson samurai curl-dev jansson-dev python3 && \
    git clone https://github.com/OleksandrChekhovskyi/hax.git /tmp/hax && \
    cd /tmp/hax && \
    make && \
    make install && \
    rm -rf /tmp/hax && \
    apk del build-base meson samurai curl-dev jansson-dev python3

# A shell is the entrypoint AgentVM exec() talks to.
CMD ["/bin/sh"]
